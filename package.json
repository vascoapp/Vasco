{
  "name": "vascoapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "contrast:check": "node scripts/contrast-audit.js",
    "i18n:audit": "node scripts/i18n-audit.js",
    "smoke:golden": "node scripts/golden-path-smoke.mjs",
    "smoke:endpoints": "node scripts/endpoint-health.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "capture:screenshots": "bash scripts/capture-screenshots.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit && echo done",
    "supabase:types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset --linked"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "babel-preset-expo": "^54.0.10",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.20",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest-expo"
      ]
    }
  },
  "private": true
}
