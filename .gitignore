# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.production
.env.staging

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# secrets (App Store / Play Store credentials)
/secrets
google-services.json
GoogleService-Info.plist

# admin build output
admin/.next/

# bundle analyze artifacts (baselines are committed; intermediates aren't)
.bundle-analyze/
.vercel

# Remotion render outputs (regenerable from compositions)
video/out/
video/.remotion-cache/

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# Local build artifacts
*.ipa

# Supabase CLI local state (linked project ref, CLI version) — machine-specific
supabase/.temp/
screenshots/
# stray maestro capture output when the script is interrupted mid-run
*_1_vandaag.png
*_2_quote_builder.png
*_3_geld.png
*_4_photo_to_quote.png
*_5_compliance.png
