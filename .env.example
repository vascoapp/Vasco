# =============================================================================
# Vasco App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ⚠️  Never put secrets (API keys, client secrets, service-role keys) behind
#     the EXPO_PUBLIC_ prefix — those are bundled into the client app and
#     visible to anyone who extracts the bundle. Secrets must live server-side
#     (Supabase Edge Functions) and be read from non-prefixed env vars.
# =============================================================================

# --- App behaviour ---
# Set to "true" to enable demo accounts + seed data in production builds.
# Leave unset or "false" for live releases.
EXPO_PUBLIC_DEMO_MODE=false

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Vasco API (optional backend) ---
EXPO_PUBLIC_VASCO_API_URL=

# --- Payments ---
# Mollie (EU contractors, EUR) and Stripe (UK contractors, GBP) connections
# are managed inside the app after OAuth. No client-side keys needed here.
# URL the Mollie/Stripe checkout redirects to after a successful payment.
EXPO_PUBLIC_PAYMENT_SUCCESS_URL=https://pay.vasco.app/success

# --- Moneybird OAuth (client_id only; client_secret stays server-side) ---
EXPO_PUBLIC_MONEYBIRD_CLIENT_ID=
EXPO_PUBLIC_MONEYBIRD_TOKEN_URL=

# --- Xero OAuth ---
EXPO_PUBLIC_XERO_CLIENT_ID=
EXPO_PUBLIC_XERO_TOKEN_URL=

# --- Error tracking ---
EXPO_PUBLIC_SENTRY_DSN=

# --- Legal URLs ---
EXPO_PUBLIC_PRIVACY_URL=https://vasco.app/privacy
EXPO_PUBLIC_TERMS_URL=https://vasco.app/terms

# =============================================================================
# SERVER-SIDE ONLY (never prefix with EXPO_PUBLIC_). Used by Supabase Edge
# Functions for webhooks + OAuth token exchange + AI calls. Configure via
# `supabase secrets set KEY=VALUE` — do not put in the app bundle.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=                # required for send-invoice + send-automation-preview (R66r49)
# MOLLIE_API_KEY=                # production Mollie key (live_...)
# MOLLIE_WEBHOOK_SECRET=         # signature validation
# STRIPE_API_KEY=                # production Stripe key (sk_live_...) — UK contractors only
# STRIPE_WEBHOOK_SECRET=         # signature validation
# ANTHROPIC_API_KEY=             # photo analysis via Claude Haiku Vision
# MONEYBIRD_CLIENT_SECRET=
# XERO_CLIENT_SECRET=
# SEND_INVOICE_FROM=             # optional override for "Vasco <onboarding@resend.dev>"
