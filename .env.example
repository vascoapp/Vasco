# =============================================================================
# Vasco App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Vasco API ---
EXPO_PUBLIC_VASCO_API_URL=

# --- Moneybird OAuth ---
EXPO_PUBLIC_MONEYBIRD_CLIENT_ID=
EXPO_PUBLIC_MONEYBIRD_TOKEN_URL=

# --- Xero OAuth ---
EXPO_PUBLIC_XERO_CLIENT_ID=
EXPO_PUBLIC_XERO_TOKEN_URL=
