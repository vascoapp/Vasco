{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_PRIVACY_URL": "https://vascobuild.com/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://vascobuild.com/terms",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./secrets/AuthKey_LAU7D8HU29.p8",
        "ascApiKeyId": "LAU7D8HU29",
        "ascApiKeyIssuerId": "215c3feb-76f3-4399-a0bb-d2385003e1b1",
        "appleTeamId": "3DX8FBF7S6"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    },
    "preview": {
      "ios": {
        "ascApiKeyPath": "./secrets/AuthKey_LAU7D8HU29.p8",
        "ascApiKeyId": "LAU7D8HU29",
        "ascApiKeyIssuerId": "215c3feb-76f3-4399-a0bb-d2385003e1b1",
        "appleTeamId": "3DX8FBF7S6"
      }
    }
  }
}
