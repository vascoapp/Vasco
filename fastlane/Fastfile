# Vasco Fastfile — App Store Connect + Play Console uploads
#
# R66r68/r69. One-command metadata + screenshot uploads so the operator
# never has to paste-into-ASC × 6 locales (or into Play Console × 6).
#
# Setup (one-time):
#   brew install fastlane
#   cd fastlane && fastlane init       # iOS — pick option 1, just metadata
#   cd fastlane && fastlane supply init # Android — generates fastlane/metadata/android/
#
# iOS usage:
#   bundle exec fastlane ios metadata     # txt files only
#   bundle exec fastlane ios screenshots  # screenshots only
#   bundle exec fastlane ios release      # both
#
# Android usage:
#   bundle exec fastlane android metadata     # txt files only
#   bundle exec fastlane android release      # txt + screenshots + listing
#
# Both lanes leave the binary alone — EAS owns app binaries.

default_platform(:ios)

# The reviewer account's password lives in secrets/reviewer-account.txt
# (gitignored) — never in fastlane/metadata, which is committed.
def reviewer_info
  f = File.expand_path('../secrets/reviewer-account.txt', __dir__)
  return {} unless File.exist?(f)
  pw = File.read(f)[/^password: (.+)$/, 1]
  pw ? { demo_password: pw } : {}
end

platform :ios do
  desc "Upload metadata to App Store Connect (no build)"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,                  # don't ask for confirmation
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      app_review_information: reviewer_info,
    )
  end

  desc "Upload screenshots to App Store Connect (no metadata, no binary)"
  lane :screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "Upload metadata + screenshots, prepare for submission"
  lane :release do
    deliver(
      app_identifier: 'com.vascobuild.app',
      # secrets/asc-api-key.json (gitignored): App Store Connect API key.
      api_key_path: File.expand_path('../secrets/asc-api-key.json', __dir__),
      # The builds are 1.0.0; Apple attaches a build only to the SAME version.
      app_version: '1.0.0',
      overwrite_screenshots: true,
      skip_binary_upload: true,     # EAS handles the binary
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,     # leave operator to click 'Submit' in ASC
      app_review_information: reviewer_info,
    )
  end
end

platform :android do
  desc "Upload Play Store listing metadata (no apk/aab)"
  lane :metadata do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"] || "../secrets/play-service-account.json",
      package_name: "com.vascobuild.app",
      track: "internal",
    )
  end

  desc "Upload Play Store listing + feature graphic + screenshots (no apk/aab)"
  lane :release do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"] || "../secrets/play-service-account.json",
      package_name: "com.vascobuild.app",
      track: "internal",                # closed internal testing first
    )
  end
end
